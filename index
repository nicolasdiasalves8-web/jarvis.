<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Jarvis · Investimentos</title>
<meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Jarvis"><meta name="theme-color" content="#03050b">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--h:200;--tx:#eef2fb;--mu:rgba(255,255,255,.55);--up:#5cf2b0;--dn:#ff6b7a;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}[hidden]{display:none!important}
body{margin:0;background:#03050b;color:var(--tx);font:400 14px/1.5 Manrope,-apple-system,system-ui,sans-serif;font-variant-numeric:tabular-nums;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;z-index:-1;background:radial-gradient(640px 420px at 10% 5%,hsla(var(--h),90%,55%,.30),transparent 65%),radial-gradient(720px 520px at 95% 30%,hsla(calc(var(--h) + 25),85%,50%,.16),transparent 65%),radial-gradient(640px 520px at 40% 100%,hsla(calc(var(--h) - 25),85%,45%,.14),transparent 65%)}
header{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:16px 22px;max-width:1280px;margin:auto}
h1{font:400 36px "Instrument Serif",serif;margin:0}h1 i{color:hsl(var(--h),95%,72%)}
nav{display:flex;gap:6px;flex-wrap:wrap;flex:1}
button,select,input,textarea{font:inherit;color:var(--tx)}
button{cursor:pointer;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.2);border-radius:999px;padding:7px 15px;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:inset 0 1px 0 rgba(255,255,255,.25)}
button:hover,button.on{background:rgba(255,255,255,.22);border-color:rgba(255,255,255,.4)}button.pr{background:hsla(var(--h),90%,60%,.35)}
input,select,textarea{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:9px 12px;min-width:0}
:focus-visible{outline:2px solid hsl(var(--h),95%,72%);outline-offset:2px}
.g{display:grid;grid-template-columns:repeat(12,1fr);gap:14px;padding:0 22px 48px;max-width:1280px;margin:auto}
.p{grid-column:span 12;position:relative;background:linear-gradient(135deg,rgba(255,255,255,.13),rgba(255,255,255,.04));backdrop-filter:blur(24px) saturate(170%);-webkit-backdrop-filter:blur(24px) saturate(170%);border:1px solid rgba(255,255,255,.17);border-radius:28px;padding:20px;box-shadow:inset 0 1px 0 rgba(255,255,255,.38),0 14px 44px rgba(0,0,0,.45);min-width:0}
.c4{grid-column:span 4}.c5{grid-column:span 5}.c7{grid-column:span 7}.c6{grid-column:span 6}
h2{margin:0 0 12px;font:400 22px "Instrument Serif",serif;color:#fff}
.big{font:400 40px/1.1 "Instrument Serif",serif}.sm{font-size:12px;color:var(--mu)}.mono{font:500 12px "JetBrains Mono",monospace}
.up{color:var(--up)}.dn{color:var(--dn)}
table{width:100%;border-collapse:collapse}td,th{padding:8px 6px;text-align:right;border-bottom:1px solid rgba(255,255,255,.08);white-space:nowrap}th{font-weight:500;font-size:11px;color:var(--mu)}td:first-child,th:first-child{text-align:left}
.sc{overflow-x:auto}.row{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.row input{flex:1;min-width:90px}
#cv{width:100%;height:280px;display:block;background:#020308;border-radius:28px}
.hud{position:absolute;left:36px;top:34px;pointer-events:none}
ul{list-style:none;margin:0;padding:0}li{padding:8px 0;border-bottom:1px solid rgba(255,255,255,.08)}li a{color:var(--tx);text-decoration:none}li a:hover{text-decoration:underline}
#log{height:360px;overflow-y:auto;background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:12px;margin-bottom:8px}
.m{white-space:pre-wrap;margin:0 0 12px}.m.u{color:hsl(var(--h),95%,78%)}
#msg{max-width:1280px;margin:0 auto 12px;padding:0 22px;color:var(--mu);font-size:12px}
@media(max-width:860px){.c4,.c5,.c6,.c7{grid-column:span 12}header{padding:12px 16px}.g{padding:0 14px 40px}}
@media(max-width:860px){nav{position:fixed;left:10px;right:10px;bottom:calc(10px + env(safe-area-inset-bottom,0px));z-index:30;flex:none;flex-wrap:nowrap;justify-content:space-between;gap:2px;padding:6px;border-radius:28px;background:rgba(20,24,34,.55);backdrop-filter:blur(26px) saturate(180%);-webkit-backdrop-filter:blur(26px) saturate(180%);border:1px solid rgba(255,255,255,.18);box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 10px 30px rgba(0,0,0,.5)}nav button{flex:1;padding:9px 2px;font-size:12px;border:0;background:none;box-shadow:none}nav button.on{background:rgba(255,255,255,.2)}body{padding-bottom:84px}#cv{height:340px}.big{font-size:34px}.hud{left:22px;top:20px}}
</style></head><body>
<header><h1>Jarvis<i>.</i></h1><nav id="nv"></nav><button class="pr" id="rf">Atualizar dados</button></header>
<div id="msg"></div>
<main class="g">
<section id="v-dash" class="g" style="grid-column:span 12;padding:0">
<div class="p" style="padding:0;overflow:hidden"><canvas id="cv" role="img" aria-label="Visualização do humor da carteira"></canvas><div class="hud"><div class="big" id="k3">0%</div><div class="sm">carteira hoje</div></div></div>
<div class="p c4"><h2>Patrimônio</h2><div class="big" id="k1">R$ 0</div></div>
<div class="p c4"><h2>Resultado</h2><div class="big" id="k2">R$ 0</div></div>
<div class="p c4"><h2>Macro</h2><div class="mono" id="mc"></div><div class="sm" id="upd"></div></div>
<div class="p c7"><h2>Ativos</h2><div class="sc"><table><thead><tr><th>Ativo</th><th>Preço</th><th>Dia</th><th>Resultado</th></tr></thead><tbody id="mv"></tbody></table></div></div>
<div class="p c5"><h2>Analistas (EUA)</h2><ul id="an"></ul><h2 style="margin-top:16px">Notícias</h2><ul id="nw"></ul></div>
</section>
<section id="v-cart" class="g" style="grid-column:span 12;padding:0" hidden>
<div class="p c7"><h2>Carteira e acompanhamento</h2><div class="row"><input id="ck" placeholder="Ativo (PETR4)"><input id="cq" type="number" placeholder="Qtd (0 = só acompanhar)"><input id="cp" type="number" step="0.01" placeholder="Preço médio"><button class="pr" id="ca">Adicionar</button></div><div class="sc"><table><thead><tr><th>Ativo</th><th>Qtd</th><th>PM</th><th></th></tr></thead><tbody id="cb"></tbody></table></div></div>
<div class="p c5"><h2>Importar do Investidor10</h2><div class="sm">Copie sua carteira e cole, uma linha por ativo: PETR4 100 35,20</div><textarea id="ip" rows="6" style="width:100%;margin-top:8px"></textarea><div class="row"><button id="ib">Importar e substituir</button></div></div>
</section>
<section id="v-al" class="g" style="grid-column:span 12;padding:0" hidden>
<div class="p c6"><h2>Novo alerta</h2><div class="row"><input id="ak" placeholder="Ativo"><select id="at"><option value="above">Preço acima de</option><option value="below">Preço abaixo de</option><option value="day">Variação do dia (±%)</option></select><input id="av" type="number" step="0.01" placeholder="Valor"><button class="pr" id="aa">Criar</button></div><button id="an2">Ativar notificações do navegador</button><ul id="al" style="margin-top:12px"></ul></div>
<div class="p c6"><h2>Disparados</h2><ul id="lg"></ul><div class="sm">Os alertas são checados quando você clica em “Atualizar dados”.</div></div>
</section>
<section id="v-di" class="g" style="grid-column:span 12;padding:0" hidden>
<div class="p c5"><h2>Diário e conhecimento</h2><div class="sm">Anote o que você aprendeu, regras suas e o motivo de cada decisão. O consultor lê tudo isso.</div><input id="dn" placeholder="Título" style="width:100%;margin-top:8px"><textarea id="dt" rows="9" style="width:100%;margin-top:8px" placeholder="Cole resumos de aulas, livros, sua tese de investimento..."></textarea><div class="row"><button class="pr" id="da">Salvar</button><input id="df" type="file" accept=".txt,.md" multiple></div></div>
<div class="p c7"><h2>Seu material</h2><ul id="dl"></ul></div>
</section>
<section id="v-ia" class="g" style="grid-column:span 12;padding:0" hidden>
<div class="p"><h2>Consultor IA</h2><div id="lgc"></div><div id="log" role="log" aria-live="polite"></div><div class="row"><input id="q" placeholder="Pergunte sobre a carteira, uma decisão ou o seu material"><button class="pr" id="go">Enviar</button></div><div class="sm">Apoio à decisão, não consultoria licenciada. Pode errar; confira os dados.</div></div>
</section>
<section id="v-cf" class="g" style="grid-column:span 12;padding:0" hidden>
<div class="p c6"><h2>Chaves e objetivo</h2><div class="sm">Ficam só neste navegador (localStorage). Nunca coloque chaves no código nem no GitHub.</div>
<div class="row"><input id="f1" placeholder="Token brapi.dev (ações B3)"></div><div class="row"><input id="f2" placeholder="Chave Finnhub (notícias e analistas)"></div><div class="row"><input id="f3" placeholder="Chave Anthropic (Claude)"></div>
<div class="row"><input id="f4" placeholder="Ações dos EUA p/ analistas: AAPL,MSFT"></div><div class="row"><input id="f6" placeholder="URL do proxy de notícias (Cloudflare Worker)"></div><textarea id="f5" rows="4" style="width:100%" placeholder="Seu objetivo: prazo, perfil de risco, meta, aporte mensal..."></textarea>
<div class="row"><button class="pr" id="fs">Salvar</button><button id="ex">Exportar backup</button><button id="im">Importar backup</button></div><input id="imf" type="file" accept=".json" hidden></div>
<div class="p c6"><h2>Fontes gratuitas usadas</h2><ul class="sm"><li>brapi.dev: cotações da B3 (grátis: 1 ativo por chamada, atraso de ~30 min)</li><li>Banco Central (SGS): Selic e IPCA, sem chave</li><li>AwesomeAPI: dólar, sem chave</li><li>Finnhub: notícias e recomendação de analistas (ações dos EUA)</li><li>Anthropic: o consultor IA (uso pago por token)</li></ul></div>
</section>
</main>
<script>
(function(){
var $=function(i){return document.getElementById(i)},K="jv2";
function ld(){try{var s=JSON.parse(localStorage.getItem(K));if(s)return s}catch(e){}return{cfg:{brapi:"",finn:"",claude:"",obj:"",us:"AAPL,MSFT"},hold:[],al:[],notes:[],px:{},mac:{},news:[],an:{},log:[],upd:""}}
var S=ld();function sv(){try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}}
var esc=function(s){return String(s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})};
var brl=function(v){return v.toLocaleString("pt-BR",{style:"currency",currency:"BRL"})},pc=function(v){return(v>=0?"+":"")+v.toFixed(2).replace(".",",")+"%"},cl=function(v){return v>=0?"up":"dn"};
function num(s){s=String(s).replace(/R\$/,"");if(s.indexOf(",")>-1)s=s.replace(/\./g,"").replace(",",".");return parseFloat(s)}
var V=[["dash","Painel"],["cart","Carteira"],["al","Alertas"],["di","Diário"],["ia","Consultor"],["cf","Ajustes"]];
V.forEach(function(x){var b=document.createElement("button");b.id="n-"+x[0];b.textContent=x[1];b.onclick=function(){go(x[0])};$("nv").appendChild(b)});
function go(v){V.forEach(function(x){$("v-"+x[0]).hidden=x[0]!==v;$("n-"+x[0]).className=x[0]===v?"on":""})}
function say(t){$("msg").textContent=t}
function td(t,c){return"<td"+(c?' class="'+c+'"':"")+">"+t+"</td>"}

/* buraco negro */
var cv=$("cv"),cx=cv.getContext("2d"),PT=[],LD=[],ST=[],hue=200,mood=0,rm=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
for(var i=0;i<2600;i++)PT.push({a:Math.random()*6.283,r:Math.pow(Math.random(),.7),s:.3+Math.random()*.7,f:0,j:Math.random()-.5});
for(i=0;i<260;i++)LD.push({a:Math.random()*6.283,k:.92+Math.random()*.22,s:Math.random()});
for(i=0;i<170;i++)ST.push({x:Math.random(),y:Math.random(),s:Math.random()});
function pal(){var d=new Date(),x=d.getHours()+d.getMinutes()/60,A=[[0,205],[6,30],[12,175],[18,12],[24,205]],i=0;while(i<3&&x>A[i+1][0])i++;var a=A[i],b=A[i+1],h=a[1]+(b[1]-a[1])*(x-a[0])/(b[0]-a[0]);return mood<0?h+(355-h)*Math.min(1,-mood*.8):h}
function setHue(){hue=pal();document.documentElement.style.setProperty("--h",hue.toFixed(0))}
function fit(){var r=cv.getBoundingClientRect(),d=window.devicePixelRatio||1;cv.width=r.width*d;cv.height=r.height*d;cx.setTransform(d,0,0,d,0,0)}
function pt(p,t,X,Y,R,rh,fr){var rad=rh*1.6+p.r*(R-rh*1.6),a=p.a+t*.0011*p.s*Math.pow(rh*1.6/rad,1.5),co=Math.cos(a),si=Math.sin(a);if((si>0)!==fr)return;
var x=X+co*rad,y=Y+si*rad*.2+p.j*rad*.02,nr=1-p.r,al=(.12+.6*p.s)*(.25+.75*nr)*(.4+.6*(-co))*(.65+.35*Math.sin(p.r*70)),sz=1+nr*1.3;
cx.fillStyle="hsla("+(hue+nr*32)+","+(100-nr*45)+"%,"+(48+nr*42)+"%,"+al+")";cx.fillRect(x,y,sz,sz);
if(p.f>.02){cx.fillStyle="hsla("+hue+",100%,92%,"+p.f+")";cx.beginPath();cx.arc(x,y,2+p.f*3,0,6.283);cx.fill();cx.fillStyle="hsla("+hue+",100%,70%,"+p.f*.25+")";cx.beginPath();cx.arc(x,y,9+p.f*10,0,6.283);cx.fill();p.f*=.975}}
function draw(t){var w=cv.clientWidth,h=cv.clientHeight,X=w<600?w*.5:w*.62,Y=h/2+h*.03,R=Math.min(w*.46,h*1.25),rh=R*.16;
cx.globalCompositeOperation="source-over";cx.fillStyle="rgba(2,3,8,.24)";cx.fillRect(0,0,w,h);
ST.forEach(function(s){cx.fillStyle="rgba(255,255,255,"+(.12+.35*Math.abs(Math.sin(t*.0006*s.s+s.x*9)))+")";cx.fillRect(s.x*w,s.y*h,1,1)});
cx.globalCompositeOperation="lighter";
var bg=cx.createRadialGradient(X,Y,rh,X,Y,R);bg.addColorStop(0,"hsla("+hue+",100%,55%,.10)");bg.addColorStop(1,"hsla("+hue+",100%,50%,0)");cx.fillStyle=bg;cx.fillRect(0,0,w,h);
PT.forEach(function(p){pt(p,t,X,Y,R,rh,false)});
cx.globalCompositeOperation="source-over";cx.fillStyle="#000";cx.beginPath();cx.arc(X,Y,rh,0,6.283);cx.fill();cx.globalCompositeOperation="lighter";
var g=cx.createRadialGradient(X,Y,rh,X,Y,rh*2.8);g.addColorStop(0,"hsla("+(hue+20)+",100%,75%,.2)");g.addColorStop(1,"hsla("+hue+",100%,60%,0)");cx.fillStyle=g;cx.beginPath();cx.arc(X,Y,rh*2.8,0,6.283);cx.fill();
LD.forEach(function(d){var up=Math.sin(d.a)<0?1:.4;cx.fillStyle="hsla("+(hue+20)+",100%,"+(70+d.s*20)+"%,"+(.12+.5*d.s)*up+")";cx.fillRect(X+Math.cos(d.a)*rh*1.75*d.k,Y+Math.sin(d.a)*rh*1.55*d.k,1.5,1.5)});
cx.shadowBlur=18;cx.shadowColor="hsl("+(hue+20)+",100%,65%)";cx.strokeStyle="hsla("+(hue+25)+",100%,88%,.95)";cx.lineWidth=1.5;cx.beginPath();cx.arc(X,Y,rh*1.03,0,6.283);cx.stroke();cx.shadowBlur=0;
PT.forEach(function(p){pt(p,t,X,Y,R,rh,true)})}
function loop(t){draw(t);requestAnimationFrame(loop)}
function flash(){PT[Math.floor(Math.random()*PT.length)].f=1}

/* dados */
function jget(u,h){return fetch(u,{headers:h||{}}).then(function(r){if(!r.ok)throw new Error("HTTP "+r.status);return r.json()})}
function tks(){return S.hold.map(function(h){return h.k})}
function notify(m){S.log.unshift({t:new Date().toLocaleString("pt-BR"),m:m});S.log.length=Math.min(S.log.length,30);try{if(window.Notification&&Notification.permission==="granted")new Notification("Jarvis",{body:m})}catch(e){}}
function checkAl(){var today=new Date().toISOString().slice(0,10);S.al.forEach(function(a){var p=S.px[a.k];if(!p)return;var hit=a.t==="above"?p.p>=a.v:a.t==="below"?p.p<=a.v:Math.abs(p.d)>=a.v;if(hit&&a.last!==today){a.last=today;notify(a.k+": "+brl(p.p)+" ("+pc(p.d)+") atingiu seu alerta")}})}
async function refresh(){var b=$("rf"),er=[];b.disabled=true;say("Atualizando…");if(await loadAuto()){b.disabled=false;return}
var ks=tks();
for(var i=0;i<ks.length;i++){try{var j=await jget("https://brapi.dev/api/quote/"+ks[i],S.cfg.brapi?{Authorization:"Bearer "+S.cfg.brapi}:{}),q=j.results[0];S.px[ks[i]]={p:q.regularMarketPrice,d:q.regularMarketChangePercent||0,n:q.shortName||ks[i]};flash()}catch(e){er.push(ks[i]+" ("+e.message+")")}}
var r=await Promise.allSettled([jget("https://api.bcb.gov.br/dados/serie/bcdata.sgs.432/dados/ultimos/1?formato=json"),jget("https://api.bcb.gov.br/dados/serie/bcdata.sgs.433/dados/ultimos/1?formato=json"),jget("https://economia.awesomeapi.com.br/json/last/USD-BRL")]);
if(r[0].status==="fulfilled")S.mac.selic=r[0].value[0].valor;if(r[1].status==="fulfilled")S.mac.ipca=r[1].value[0].valor;if(r[2].status==="fulfilled")S.mac.usd=brl(+r[2].value.USDBRL.bid);
if(S.cfg.finn){try{var n=await jget("https://finnhub.io/api/v1/news?category=general&token="+S.cfg.finn);S.news=n.slice(0,8).map(function(x){return{h:x.headline,u:x.url,s:x.source}})}catch(e){er.push("notícias")}
var us=S.cfg.us.split(",").map(function(x){return x.trim().toUpperCase()}).filter(Boolean);S.an={};
for(var k=0;k<us.length;k++){try{var a=await jget("https://finnhub.io/api/v1/stock/recommendation?symbol="+us[k]+"&token="+S.cfg.finn);if(a[0])S.an[us[k]]=a[0]}catch(e){er.push(us[k])}}}
if(S.cfg.proxy){try{var pn=await jget(S.cfg.proxy);S.news=pn.concat(S.news).slice(0,14)}catch(e){er.push("proxy de notícias")}}S.upd=new Date().toLocaleString("pt-BR");checkAl();sv();renderAll();setHue();b.disabled=false;say(er.length?"Falhou: "+er.join(", "):"Dados atualizados.")}

async function loadAuto(){try{var d=await jget("data/dados.json?t="+Date.now());if(!d||!d.px||!Object.keys(d.px).length)return false;
Object.keys(d.px).forEach(function(k){S.px[k]=d.px[k]});S.mac=d.mac||S.mac;if(d.news&&d.news.length)S.news=d.news;S.an=d.an||S.an;S.upd=new Date(d.upd).toLocaleString("pt-BR")+" (automático)";
checkAl();sv();renderAll();setHue();flash();say(d.erros&&d.erros.length?"Falhou no servidor: "+d.erros.join(", "):"Dados automáticos carregados.");return true}catch(e){return false}}
/* telas */
function dash(){var v=0,c=0,dd=0,rows="";S.hold.forEach(function(h){var p=S.px[h.k];if(!p)return;var res=h.q?(p.p-h.c)*h.q:0;if(h.q){v+=h.q*p.p;c+=h.q*h.c;dd+=h.q*p.p*p.d/100}
rows+="<tr>"+td('<span class="mono">'+esc(h.k)+"</span>")+td(brl(p.p))+td(pc(p.d),cl(p.d))+td(h.q?brl(res):"–",h.q?cl(res):"")+"</tr>"});
mood=v?dd/v*100:0;$("mv").innerHTML=rows||'<tr><td colspan="4" class="sm">Adicione ativos na Carteira e clique em Atualizar dados.</td></tr>';
$("k1").textContent=brl(v);$("k2").textContent=brl(v-c);$("k2").className="big "+cl(v-c);$("k3").textContent=pc(mood);$("k3").className="big "+cl(mood);
var m=S.mac;$("mc").textContent=[m.selic&&"Selic "+m.selic+"% a.a.",m.ipca&&"IPCA mês "+m.ipca+"%",m.usd&&"USD "+m.usd].filter(Boolean).join(" · ")||"–";$("upd").textContent=S.upd?"Atualizado em "+S.upd:"";
$("an").innerHTML=Object.keys(S.an).map(function(k){var a=S.an[k];return"<li><span class='mono'>"+esc(k)+"</span> Compra "+(a.strongBuy+a.buy)+" · Neutro "+a.hold+" · Venda "+(a.sell+a.strongSell)+"</li>"}).join("")||'<li class="sm">Informe a chave Finnhub em Ajustes.</li>';
$("nw").innerHTML=S.news.map(function(n){return"<li><a href='"+esc(n.u)+"' target='_blank' rel='noopener'>"+esc(n.h)+"</a><div class='sm'>"+esc(n.s)+"</div></li>"}).join("")}
function cart(){$("cb").innerHTML=S.hold.map(function(h,i){return"<tr>"+td('<span class="mono">'+esc(h.k)+"</span>")+td(h.q)+td(brl(h.c))+td('<button data-r="'+i+'" aria-label="Remover">×</button>')+"</tr>"}).join("")}
function al(){$("al").innerHTML=S.al.map(function(a,i){return"<li>"+esc(a.k)+" · "+(a.t==="above"?"acima de ":a.t==="below"?"abaixo de ":"variação ±")+a.v+" <button data-a='"+i+"' aria-label='Remover'>×</button></li>"}).join("")||'<li class="sm">Nenhum alerta.</li>';
$("lg").innerHTML=S.log.map(function(l){return"<li>"+esc(l.m)+"<div class='sm'>"+esc(l.t)+"</div></li>"}).join("")||'<li class="sm">Nada disparado ainda.</li>'}
function di(){$("dl").innerHTML=S.notes.map(function(n,i){return"<li><b>"+esc(n.n)+"</b> <span class='sm'>"+Math.round(n.t.length/1000)+" mil caracteres</span> <button data-d='"+i+"' aria-label='Remover'>×</button></li>"}).join("")||'<li class="sm">Nenhum material ainda.</li>'}
function cf(){$("f1").value=S.cfg.brapi;$("f2").value=S.cfg.finn;$("f3").value=S.cfg.claude;$("f4").value=S.cfg.us;$("f5").value=S.cfg.obj;$("f6").value=S.cfg.proxy||""}
function renderAll(){dash();cart();al();di()}

/* ações */
$("rf").onclick=refresh;
$("ca").onclick=function(){var k=$("ck").value.trim().toUpperCase(),q=+$("cq").value||0,c=+$("cp").value||0;if(!/^[A-Z]{4}\d{1,2}$/.test(k))return say("Ativo inválido. Exemplo: PETR4");if(S.demo){S.hold=[];S.px={};S.demo=0}S.hold=S.hold.filter(function(h){return h.k!==k});S.hold.push({k:k,q:q,c:c});sv();["ck","cq","cp"].forEach(function(i){$(i).value=""});renderAll()};
$("cb").onclick=function(e){var r=e.target.getAttribute("data-r");if(r!==null){S.hold.splice(+r,1);sv();renderAll()}};
$("ib").onclick=function(){var o=[];$("ip").value.split(/\n/).forEach(function(l){var t=l.trim().split(/[\t;\s]+/),k=(t[0]||"").toUpperCase();if(!/^[A-Z]{4}\d{1,2}$/.test(k))return;var n=t.slice(1).map(num).filter(isFinite);if(n.length>1&&n[0]>0)o.push({k:k,q:n[0],c:n[1]})});if(!o.length)return say("Nenhuma linha reconhecida. Use: ATIVO quantidade preço-médio");S.hold=o;S.demo=0;sv();$("ip").value="";renderAll();say(o.length+" ativos importados. Clique em Atualizar dados.")};
$("aa").onclick=function(){var k=$("ak").value.trim().toUpperCase(),v=+$("av").value;if(!k||!v)return;S.al.push({k:k,t:$("at").value,v:v});sv();$("ak").value="";$("av").value="";al()};
$("al").onclick=function(e){var r=e.target.getAttribute("data-a");if(r!==null){S.al.splice(+r,1);sv();al()}};
$("an2").onclick=function(){if(!window.Notification)return say("Este navegador não suporta notificações.");Notification.requestPermission().then(function(p){say("Notificações: "+p)})};
function addDoc(n,t){if(t.trim()){S.notes.push({n:n||"Sem título",t:t.slice(0,150000)});sv();di()}}
$("da").onclick=function(){addDoc($("dn").value,$("dt").value);$("dn").value="";$("dt").value=""};
$("df").onchange=function(e){Array.prototype.forEach.call(e.target.files,function(f){var r=new FileReader();r.onload=function(){addDoc(f.name,String(r.result))};r.readAsText(f)});e.target.value=""};
$("dl").onclick=function(e){var r=e.target.getAttribute("data-d");if(r!==null){S.notes.splice(+r,1);sv();di()}};
$("fs").onclick=function(){S.cfg={brapi:$("f1").value.trim(),finn:$("f2").value.trim(),claude:$("f3").value.trim(),us:$("f4").value.trim(),proxy:$("f6").value.trim(),obj:$("f5").value.trim()};sv();say("Ajustes salvos.")};
$("ex").onclick=function(){var a=document.createElement("a");a.href=URL.createObjectURL(new Blob([JSON.stringify(S)],{type:"application/json"}));a.download="jarvis-backup.json";a.click()};
$("im").onclick=function(){$("imf").click()};
$("imf").onchange=function(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(){try{S=JSON.parse(r.result);sv();cf();renderAll();say("Backup importado.")}catch(x){say("Arquivo inválido.")}};r.readAsText(f)};

/* consultor IA */
var HI=[];
function chat(c,t){var p=document.createElement("p");p.className="m "+c;p.textContent=t;$("log").appendChild(p);$("log").scrollTop=1e9;return p}
function chunks(q){var w=q.toLowerCase().split(/\W+/).filter(function(x){return x.length>3}),o=[],tot=0;S.notes.forEach(function(d){tot+=d.t.length});
S.notes.forEach(function(d){for(var i=0;i<d.t.length;i+=900){var c=d.t.slice(i,i+900),l=c.toLowerCase(),s=tot<6000?1:0;w.forEach(function(x){if(l.indexOf(x)>-1)s++});if(s)o.push({s:s,n:d.n,c:c})}});return o.sort(function(a,b){return b.s-a.s}).slice(0,5)}
async function ask(q){if(!q)return;chat("u","Você: "+q);if(!S.cfg.claude){chat("a","Cole sua chave da Anthropic em Ajustes.");return}
var o=chat("a","…");HI.push({role:"user",content:q});
var sys="Você é um consultor de investimentos em português do Brasil. Ajude o usuário a decidir de acordo com o objetivo dele. Use apenas os dados abaixo; diga quando faltar informação e peça o que precisar. Cite o material do usuário quando usar. Nunca garanta retorno nem dê ordem de compra ou venda: apresente cenários, riscos e contra-argumentos. Seja direto.\n\nOBJETIVO: "+(S.cfg.obj||"não informado")+"\n\nCARTEIRA:\n"+(S.hold.map(function(h){var p=S.px[h.k];return h.k+": "+h.q+" cotas, PM "+h.c+(p?", preço "+p.p+", dia "+pc(p.d):"")}).join("\n")||"vazia")+"\n\nMACRO: "+JSON.stringify(S.mac)+"\nNOTÍCIAS: "+S.news.map(function(n){return n.h}).join(" | ")+"\nANALISTAS (EUA): "+JSON.stringify(S.an);
var ch=chunks(q);if(ch.length)sys+="\n\nMATERIAL DO USUÁRIO:\n"+ch.map(function(c){return"["+c.n+"] "+c.c}).join("\n---\n");
try{var r=await fetch("https://api.anthropic.com/v1/messages",{method:"POST",headers:{"content-type":"application/json","x-api-key":S.cfg.claude,"anthropic-version":"2023-06-01","anthropic-dangerous-direct-browser-access":"true"},body:JSON.stringify({model:"claude-sonnet-5-5",max_tokens:1500,system:sys,messages:HI})});
var j=await r.json();if(!r.ok)throw new Error(j.error&&j.error.message||r.status);var t=j.content.map(function(c){return c.text||""}).join("");o.textContent=t;HI.push({role:"assistant",content:t});HI=HI.slice(-12)}
catch(e){o.textContent="Erro: "+e.message;HI.pop()}}
$("go").onclick=function(){var v=$("q").value.trim();$("q").value="";ask(v)};$("q").onkeydown=function(e){if(e.key==="Enter")$("go").click()};
chat("a","Olá. Registre seu objetivo e seu material, atualize os dados e me pergunte o que quiser sobre a carteira.");

if(!S.hold.length&&!S.upd){S.demo=1;S.hold=[{k:"PETR4",q:100,c:35},{k:"VALE3",q:40,c:60},{k:"ITUB4",q:80,c:30}];S.px={PETR4:{p:38.2,d:1.4,n:"Petrobras"},VALE3:{p:62.5,d:-.6,n:"Vale"},ITUB4:{p:34.8,d:.8,n:"Itaú"}};S.mac={selic:"14,50",ipca:"0,40",usd:"R$ 5,30"};S.news=[{h:"Exemplo: configure o proxy ou a chave Finnhub para ver notícias reais",u:"#",s:"demonstração"}];say("Dados de exemplo. Importe sua carteira e clique em Atualizar dados.")}cf();renderAll();go("dash");setHue();loadAuto();fit();window.addEventListener("resize",fit);
if(rm){for(var q=0;q<40;q++)draw(q*50)}else requestAnimationFrame(loop);
})();
</script></body></html>
